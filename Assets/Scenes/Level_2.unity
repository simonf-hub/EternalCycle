  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DivineSense.CooperativeLevelController
  Session: {fileID: 1612598374}
  Setup: {fileID: 1612598376}
  Title: "Level 2 \xB7 Athena's Trial"
  AngelStart: {fileID: 309398490}
  DevilStart: {fileID: 2023985713}
  Exit: {fileID: 1521377469}
  Checkpoints:
  - Zone: {fileID: 1796202848}
    AngelSpawn: {fileID: 1796202847}
    DevilSpawn: {fileID: 1796202846}
  - Zone: {fileID: 2027146578}
    AngelSpawn: {fileID: 2027146577}
    DevilSpawn: {fileID: 2027146576}
  - Zone: {fileID: 1544637263}
    AngelSpawn: {fileID: 1544637262}
    DevilSpawn: {fileID: 1544637261}
  Lessons:
  - Zone: {fileID: 1844629492}
    Title: Cross the first gap
    Instructions: Reveal the hidden steps with Sight. Move to the revealed edge and cast again if the next step is out of range.
  - Zone: {fileID: 2125985040}
    Title: Clear the lower gallery
    Instructions: Mortal 2 can break the cracked wall with Sound. Give your partner room, since the same cast can knock them back.
  - Zone: {fileID: 869921364}
    Title: Open gate I
    Instructions: Take different paths. Stand on the upper and lower plates at the same time to open the gate.
  - Zone: {fileID: 545319683}
    Title: Ascend together
    Instructions: Use Sight from the edge and again from the revealed steps. Save a jump or glide for the last rise.
  - Zone: {fileID: 1575827000}
    Title: Clear the upper gallery
    Instructions: Use Sound to break the second wall, then climb up to the last pair of plates.
  - Zone: {fileID: 717059985}
    Title: Open gate II
    Instructions: One mortal climbs to the balcony while the other takes the floor route. Stand on both plates together.
  - Zone: {fileID: 1285957326}
    Title: Reach the exit together
    Instructions: Both mortals must reach the final exit after uncovering the path and opening both gates.
  RequiredReveals:
  - {fileID: 1875093622}
  - {fileID: 1218576779}
  - {fileID: 2099896462}
  - {fileID: 1782205279}
  RequiredBreaks:
  - {fileID: 985437736}
  - {fileID: 1952344910}
  RequiredGifts: []
  RequiredGates:
  - {fileID: 1288453492}
  - {fileID: 38680612}
