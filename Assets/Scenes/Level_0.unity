  m_Script: {fileID: 11500000, guid: e26e2436221824801b168d45bd34ad3d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DivineSense.CooperativeLevelController
  Session: {fileID: 545319682}
  Setup: {fileID: 545319685}
  Title: "Level 0 \xB7 First Steps"
  AngelStart: {fileID: 869921363}
  DevilStart: {fileID: 211415084}
  Exit: {fileID: 796666422}
  Checkpoints:
  - Zone: {fileID: 1521377471}
    AngelSpawn: {fileID: 1521377470}
    DevilSpawn: {fileID: 1521377469}
  - Zone: {fileID: 1748605952}
    AngelSpawn: {fileID: 1748605951}
    DevilSpawn: {fileID: 1748605950}
  Lessons:
  - Zone: {fileID: 259988255}
    Title: Move and jump
    Instructions: "Use the left stick to move and A to jump. On keyboard, Mortal 1 uses A/D and W, and Mortal 2 uses \u2190/\u2192 and \u2191."
  - Zone: {fileID: 823139854}
    Title: "Mortal 1 \xB7 Sight"
    Instructions: Jump the gap or press B nearby to reveal a bridge. Sight also hides your partner for 1.5 seconds. Keyboard cast is S.
  - Zone: {fileID: 1875093622}
    Title: "Mortal 2 \xB7 Sound"
    Instructions: "Jump over the cracked wall or press B nearby to break it. Sound also knocks your partner away. Keyboard cast is \u2193."
  - Zone: {fileID: 190175577}
    Title: "Athena\u2019s Position"
    Instructions: Touch the gift to swap positions with your partner. Try it while standing apart. It also swaps respawn markers when they are in use.
  - Zone: {fileID: 985437736}
    Title: "Zeus\u2019s Agility"
    Instructions: "For 3 seconds you are 1.5\xD7 larger, jump 50% higher and move at 65% speed. Try reaching the high practice ledge. Sight and Sound cannot affect you."
  - Zone: {fileID: 389418529}
    Title: "Hera\u2019s Pull"
    Instructions: Touch the gift while your partner is nearby. Hera pulls them toward you.
  - Zone: {fileID: 840836443}
    Title: "Ares\u2019s Stare"
    Instructions: The gift launches a homing bomb toward your partner. A hit stuns them for 3 seconds.
  - Zone: {fileID: 1288453492}
    Title: Reach the exit together
    Instructions: Mortal 1 can hold A while falling to glide and release to dash upward. Mortal 2 can jump again in midair or double-tap a direction to dash.
  RequiredReveals: []
  RequiredBreaks: []
  RequiredGifts: []
  RequiredGates: []
  ViewHeight: 5.5
  LeftLimit: {fileID: 1913400138}
  RightLimit: {fileID: 1433602566}
  FallLimit: {fileID: 1629211799}
